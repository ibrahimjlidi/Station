generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  gerant
  caissier
  vendeur
}

enum TypeAchatEssence {
  achat
  retour
}

enum CaisseType {
  POS
  PISTE
}

model User {
  id           Int             @id @default(autoincrement())
  magasinId    Int?
  username     String          @unique @db.VarChar(80)
  passwordHash String          @db.VarChar(255)
  nom          String          @db.VarChar(120)
  prenom       String          @default("") @db.VarChar(120)
  telephone    String?         @db.VarChar(30)
  role         Role            @default(vendeur)
  actif        Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  vendeur      Vendeur?
  magasin      Magasin?        @relation(fields: [magasinId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  inventaires  Invent[]
  transferts   TransEtranger[]

  @@index([role, actif])
  @@index([magasinId])
}

model Station {
  id            Int       @id @default(autoincrement())
  code          String    @unique @db.VarChar(30)
  nom           String    @db.VarChar(160)
  active        Boolean   @default(true)
  magasin       Magasin?
  configuration SetParam?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Magasin {
  id                     Int                   @id @default(autoincrement())
  stationId              Int                   @unique
  code                   String                @db.VarChar(30)
  nom                    String                @db.VarChar(160)
  active                 Boolean               @default(true)
  station                Station               @relation(fields: [stationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  caisses                Caisse[]
  equipes                Equipe[]
  cuves                  Cuve[]
  vendeurs               Vendeur[]
  pompes                 Pompe[]
  recettes               RecetteCaisse[]
  depenses               DepensesCaisse[]
  credits                CreditCaisse[]
  achatsEssence          AchatEssence[]
  achatsProduits         AchatProd[]
  bonsLivraison          Bonliv[]
  factures               Facture[]
  reglementsFournisseurs RegFour[]
  retenues               EntRas[]
  avoirs                 EntAvoir[]
  mouvementsBancaires    DetMvtBq[]
  retoursCuve            RetourCuve[]
  inventairesCarburant   InventaireCarburant[]
  users                  User[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([stationId, code])
}

model Fournisseur {
  id              Int             @id @default(autoincrement())
  code            String          @unique @db.VarChar(30)
  raisonSociale   String          @db.VarChar(160)
  matriculeFiscal String?         @db.VarChar(40)
  telephone       String?         @db.VarChar(30)
  adresse         String?         @db.VarChar(255)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  achats          AchatEssence[]
  reglements      RegFour[]
  avoirs          EntAvoir[]
  retenues        EntRas[]
  detailsRas      DetRas[]
  produits        Produit[]
  achatsProduits  AchatProd[]
  transferts      TransEtranger[]
  ventesBoutique  CarProdSiege[]
}

model Cuve {
  id                   Int                         @id @default(autoincrement())
  magasinId            Int?
  code                 String                      @unique @db.VarChar(30)
  libelle              String                      @db.VarChar(100)
  carburant            String                      @db.VarChar(60)
  volumeTotal          Decimal                     @db.Decimal(15, 3)
  stockInitial         Decimal                     @default(0) @db.Decimal(15, 3)
  stock                Decimal                     @default(0) @db.Decimal(15, 3)
  prixAchatHT          Decimal                     @default(0) @db.Decimal(15, 3)
  seuilAlerte          Decimal                     @default(0) @db.Decimal(15, 3)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  magasin              Magasin?                    @relation(fields: [magasinId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  pompes               Pompe[]
  detailsAchat         DetailAchatEssence[]
  jaugeages            Jaugeage[]
  detailsRecette       DetailRecetteCaisse[]
  detailsRetours       DetailRetour[]
  inventairesCarburant DetailInventaireCarburant[]
  releves              MobVCarCaisse[]

  @@index([carburant])
  @@index([magasinId])
}

model Pompe {
  id             Int             @id @default(autoincrement())
  magasinId      Int?
  caisseId       Int?
  code           String          @unique @db.VarChar(30)
  libelle        String          @db.VarChar(100)
  active         Boolean         @default(true)
  prixVente      Decimal         @default(0) @db.Decimal(15, 3)
  cuveId         Int
  cuve           Cuve            @relation(fields: [cuveId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  magasin        Magasin?        @relation(fields: [magasinId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  caisse         Caisse?         @relation(fields: [caisseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  releves        MobVCarCaisse[]
  ventesBoutique CarProdSiege[]
  detailsRetours DetailRetour[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([cuveId, active])
  @@index([magasinId])
}

model Equipe {
  id                Int                @id @default(autoincrement())
  magasinId         Int?
  code              String             @unique @db.VarChar(30)
  libelle           String             @db.VarChar(100)
  actif             Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  magasin           Magasin?           @relation(fields: [magasinId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  vendeurs          Vendeur[]
  releves           MobVCarCaisse[]
  jaugeages         Jaugeage[]
  recettes          RecetteCaisse[]
  depenses          DepensesCaisse[]
  credits           CreditCaisse[]
  clotures          JoursClotures[]
  reglementsClients DetailReglements[]
  ventesBoutique    CarProdSiege[]
  retoursCuve       RetourCuve[]
  posTickets        POSTicket[]

  @@index([actif])
  @@index([magasinId])
}

model Caisse {
  id                Int                @id @default(autoincrement())
  magasinId         Int?
  code              String             @unique @db.VarChar(30)
  libelle           String             @db.VarChar(100)
  type              CaisseType         @default(PISTE)
  actif             Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  magasin           Magasin?           @relation(fields: [magasinId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  pompes            Pompe[]
  releves           MobVCarCaisse[]
  jaugeages         Jaugeage[]
  recettes          RecetteCaisse[]
  depenses          DepensesCaisse[]
  credits           CreditCaisse[]
  reglementsClients DetailReglements[]
  ventesBoutique    CarProdSiege[]
  retoursCuve       RetourCuve[]
  posTickets        POSTicket[]

  @@index([actif])
  @@index([magasinId])
}

model Vendeur {
  id             Int              @id @default(autoincrement())
  magasinId      Int?
  equipeId       Int?
  matricule      String           @unique @db.VarChar(30)
  nom            String           @db.VarChar(120)
  actif          Boolean          @default(true)
  userId         Int?             @unique
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  magasin        Magasin?         @relation(fields: [magasinId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  equipe         Equipe?          @relation(fields: [equipeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  releves        MobVCarCaisse[]
  recettes       RecetteCaisse[]
  depenses       DepensesCaisse[]
  credits        CreditCaisse[]
  ventesBoutique CarProdSiege[]
  retoursCuve    RetourCuve[]
  posTickets     POSTicket[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([actif])
  @@index([magasinId])
}

model MobVCarCaisse {
  id             Int       @id @default(autoincrement())
  date           DateTime  @db.Date
  equipeId       Int
  caisseId       Int
  pompeId        Int
  vendeurId      Int
  indexOuverture Decimal   @db.Decimal(15, 3)
  indexFermeture Decimal?  @db.Decimal(15, 3)
  prixVente      Decimal   @db.Decimal(15, 3)
  statut         String    @default("OUVERT") @db.VarChar(10)
  heureOuverture DateTime  @default(now())
  heureFermeture DateTime?
  cuveId         Int?
  recetteCaisseId Int?
  equipe         Equipe    @relation(fields: [equipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  caisse         Caisse    @relation(fields: [caisseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pompe          Pompe     @relation(fields: [pompeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vendeur        Vendeur   @relation(fields: [vendeurId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cuve           Cuve?     @relation(fields: [cuveId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recetteCaisse  RecetteCaisse? @relation(fields: [recetteCaisseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([date, equipeId, caisseId, pompeId])
  @@index([date, equipeId, caisseId])
  @@index([pompeId, indexFermeture])
  @@index([recetteCaisseId, pompeId])
}

model AchatEssence {
  id            Int                  @id @default(autoincrement())
  magasinId     Int?
  date          DateTime             @db.Date
  fournisseurId Int
  type          TypeAchatEssence     @default(achat)
  reference     String?              @db.VarChar(80)
  fournisseur   Fournisseur          @relation(fields: [fournisseurId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  magasin       Magasin?             @relation(fields: [magasinId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  details       DetailAchatEssence[]
  reglements    DetailRegFour[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([date, fournisseurId])
  @@index([magasinId])
}

model DetailAchatEssence {
  id           Int          @id @default(autoincrement())
  achatId      Int
  cuveId       Int
  quantite     Decimal      @db.Decimal(15, 3)
  prixUnitaire Decimal      @db.Decimal(15, 3)
  achat        AchatEssence @relation(fields: [achatId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cuve         Cuve         @relation(fields: [cuveId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([cuveId, createdAt])
  @@index([achatId])
}

model Jaugeage {
  id          Int            @id @default(autoincrement())
  date        DateTime       @db.Date
  cuveId      Int
  equipeId    Int
  caisseId    Int
  niveau      Decimal        @db.Decimal(15, 3)
  quantite    Decimal        @default(0) @db.Decimal(15, 3)
  temperature Decimal?       @db.Decimal(15, 3)
  observation String?        @db.VarChar(255)
  type        String         @default("MANUEL") @db.VarChar(10)
  sessionId   Int?
  ecart       Decimal?       @db.Decimal(15, 3)
  cuve        Cuve           @relation(fields: [cuveId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  equipe      Equipe         @relation(fields: [equipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  caisse      Caisse         @relation(fields: [caisseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session     RecetteCaisse? @relation(fields: [sessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([date, cuveId, type])
  @@index([date, equipeId, caisseId])
  @@index([cuveId, date])
}

model Vehicule {
  id            Int         @id @default(autoincrement())
  clientId      Int
  matricule     String      @db.VarChar(20)
  marque        String?     @db.VarChar(50)
  modele        String?     @db.VarChar(50)
  annee         Int?
  carburantType Int?        @db.TinyInt
  indexKmActuel BigInt?
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  entretiens    Entretien[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([clientId, matricule])
  @@index([clientId, matricule])
}

model Service {
  id        Int            @id @default(autoincrement())
  libelle   String         @db.VarChar(100)
  prixHT    Decimal        @db.Decimal(15, 3)
  tauxTVA   Decimal        @db.Decimal(5, 2)
  prixTTC   Decimal        @db.Decimal(15, 3)
  actif     Boolean        @default(true)
  details   Detentretien[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model RetourCuve {
  id          Int            @id @default(autoincrement())
  date        DateTime       @db.Date
  equipeId    Int
  caisseId    Int
  vendeurId   Int
  magasinId   Int
  totalVolume Decimal        @db.Decimal(15, 3)
  totalValeur Decimal        @db.Decimal(15, 3)
  valide      Boolean        @default(false)
  equipe      Equipe         @relation(fields: [equipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  caisse      Caisse         @relation(fields: [caisseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vendeur     Vendeur        @relation(fields: [vendeurId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  magasin     Magasin        @relation(fields: [magasinId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  details     DetailRetour[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([date, equipeId, caisseId])
  @@index([date, equipeId, caisseId])
}

model DetailRetour {
  id           Int        @id @default(autoincrement())
  retourCuveId Int
  pompeId      Int
  cuveId       Int
  volume       Decimal    @db.Decimal(15, 3)
  valeur       Decimal    @db.Decimal(15, 3)
  tauxTVA      Decimal    @db.Decimal(5, 2)
  valide       Boolean    @default(false)
  retourCuve   RetourCuve @relation(fields: [retourCuveId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pompe        Pompe      @relation(fields: [pompeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cuve         Cuve       @relation(fields: [cuveId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model InventaireCarburant {
  id          Int                         @id @default(autoincrement())
  date        DateTime                    @db.Date
  operateur   String                      @db.VarChar(100)
  cloture     Boolean                     @default(false)
  valeurStock Decimal                     @db.Decimal(15, 3)
  magasinId   Int
  magasin     Magasin                     @relation(fields: [magasinId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lignes      DetailInventaireCarburant[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@index([date, magasinId])
}

model DetailInventaireCarburant {
  id              Int                 @id @default(autoincrement())
  inventaireCarId Int
  cuveId          Int
  date            DateTime            @db.Date
  stockPhysique   Decimal             @db.Decimal(15, 3)
  stockComptable  Decimal             @db.Decimal(15, 3)
  prixUnitaire    Decimal             @db.Decimal(15, 3)
  valeur          Decimal             @db.Decimal(15, 3)
  ecart           Decimal             @db.Decimal(15, 3)
  inventaire      InventaireCarburant @relation(fields: [inventaireCarId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cuve            Cuve                @relation(fields: [cuveId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt       DateTime            @default(now())

  @@unique([inventaireCarId, cuveId])
  @@index([date, cuveId])
}

model RecetteCaisse {
  id                      Int                   @id @default(autoincrement())
  magasinId               Int?
  date                    DateTime              @db.Date
  equipeId                Int
  caisseId                Int
  vendeurId               Int
  totalRecettes           Decimal               @default(0) @db.Decimal(15, 3)
  reserveDepart           Decimal               @default(0) @db.Decimal(15, 3)
  recetteTheorique        Decimal               @default(0) @db.Decimal(15, 3)
  ecartRecette            Decimal               @default(0) @db.Decimal(15, 3)
  reserveFinTheorique     Decimal               @default(0) @db.Decimal(15, 3)
  reserveFinAttendue      Decimal               @default(0) @db.Decimal(15, 3)
  ecartCaisse             Decimal               @default(0) @db.Decimal(15, 3)
  seuilTolerance          Decimal               @default(0.5) @db.Decimal(15, 3)
  commentaireEcart        String?               @db.Text
  fondsCaisseOuverture    Decimal               @default(0) @db.Decimal(15, 3)
  fondsCaisseFermeture    Decimal?              @db.Decimal(15, 3)
  depotBanque             Decimal?              @db.Decimal(15, 3)
  totalEspeces            Decimal               @default(0) @db.Decimal(15, 3)
  totalCheques            Decimal               @default(0) @db.Decimal(15, 3)
  totalCarte              Decimal               @default(0) @db.Decimal(15, 3)
  totalTheoriqueCarburant Decimal               @default(0) @db.Decimal(15, 3)
  totalTheoriqueBoutique  Decimal               @default(0) @db.Decimal(15, 3)
  statutEcart             String?               @db.VarChar(20)
  statut                  String                @default("OUVERT") @db.VarChar(10)
  heureOuverture          DateTime              @default(now())
  heureFermeture          DateTime?
  validePar               Int?
  fait                    Boolean               @default(false)
  equipe                  Equipe                @relation(fields: [equipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  caisse                  Caisse                @relation(fields: [caisseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vendeur                 Vendeur               @relation(fields: [vendeurId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  magasin                 Magasin?              @relation(fields: [magasinId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  details                 DetailRecetteCaisse[]
  jaugeages               Jaugeage[]
  relevesPompes           MobVCarCaisse[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([date, equipeId, caisseId])
  @@index([date, equipeId, caisseId, vendeurId])
}

model DetailRecetteCaisse {
  id            Int           @id @default(autoincrement())
  numRecette    Int
  modePaymentId Int
  montant       Decimal       @db.Decimal(15, 3)
  numero        String?       @db.VarChar(80)
  idCuve        Int?
  date          DateTime      @default(now())
  equipeId      Int?
  caisseId      Int?
  vendeurId     Int?
  valide        Boolean       @default(true)
  recette       RecetteCaisse @relation(fields: [numRecette], references: [id], onDelete: Cascade, onUpdate: Cascade)
  modePayment   ModePayment   @relation(fields: [modePaymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cuve          Cuve?         @relation(fields: [idCuve], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([numRecette])
  @@index([modePaymentId])
  @@index([idCuve])
}

model DepensesCaisse {
  id            Int              @id @default(autoincrement())
  magasinId     Int?
  date          DateTime         @db.Date
  equipeId      Int
  caisseId      Int
  vendeurId     Int
  totalDepenses Decimal          @default(0) @db.Decimal(15, 3)
  fait          Boolean          @default(false)
  equipe        Equipe           @relation(fields: [equipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  caisse        Caisse           @relation(fields: [caisseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vendeur       Vendeur          @relation(fields: [vendeurId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  magasin       Magasin?         @relation(fields: [magasinId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  details       DetailDepenses[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([date, equipeId, caisseId])
  @@index([date, equipeId, caisseId, vendeurId])
  @@index([magasinId])
}

model DetailDepenses {
  id          Int            @id @default(autoincrement())
  numDepense  Int
  codeDepense Int
  montant     Decimal        @db.Decimal(15, 3)
  libelle     String?        @db.VarChar(255)
  date        DateTime       @default(now())
  equipeId    Int?
  caisseId    Int?
  vendeurId   Int?
  valide      Boolean        @default(true)
  depense     DepensesCaisse @relation(fields: [numDepense], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type        Depenses       @relation(fields: [codeDepense], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([numDepense])
  @@index([codeDepense])
}

model CreditCaisse {
  id           Int            @id @default(autoincrement())
  magasinId    Int?
  date         DateTime       @db.Date
  equipeId     Int
  caisseId     Int
  vendeurId    Int
  totalCredits Decimal        @default(0) @db.Decimal(15, 3)
  fait         Boolean        @default(false)
  equipe       Equipe         @relation(fields: [equipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  caisse       Caisse         @relation(fields: [caisseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vendeur      Vendeur        @relation(fields: [vendeurId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  magasin      Magasin?       @relation(fields: [magasinId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  details      DetailCredit[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([date, equipeId, caisseId])
  @@index([date, equipeId, caisseId, vendeurId])
  @@index([magasinId])
}

model DetailCredit {
  id          Int          @id @default(autoincrement())
  numCredit   Int
  clientId    Int
  montant     Decimal      @db.Decimal(15, 3)
  libelle     String?      @db.VarChar(255)
  date        DateTime     @default(now())
  equipeId    Int?
  caisseId    Int?
  vendeurId   Int?
  valide      Boolean      @default(true)
  modePayment String?      @db.VarChar(80)
  credit      CreditCaisse @relation(fields: [numCredit], references: [id], onDelete: Cascade, onUpdate: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([numCredit])
  @@index([clientId])
}

model JoursClotures {
  id        Int      @id @default(autoincrement())
  dateJour  DateTime @db.Date
  equipeId  Int
  fait      Boolean  @default(false)
  equipe    Equipe   @relation(fields: [equipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dateJour, equipeId])
  @@index([dateJour, equipeId, fait])
}

model ModePayment {
  id                   Int                   @id @default(autoincrement())
  libelle              String                @db.VarChar(100)
  famille              String?               @db.VarChar(80)
  famillePaymentId     Int?
  compteCPT            String?               @db.VarChar(40)
  detailsRecette       DetailRecetteCaisse[]
  mouvementsBancaires  DetMvtBq[]
  configurationsBanque AgeoCompteMode[]
  posTicketPayments   POSTicketPayment[]
