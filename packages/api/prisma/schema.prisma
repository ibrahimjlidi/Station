}

model Detentretien {
  id             Int       @id @default(autoincrement())
  entretienId    Int
  idService      Int?
  serviceId      Int?
  prixHT         Decimal   @db.Decimal(15, 3)
  prixTTC        Decimal   @db.Decimal(15, 3)
  numLigne       Int
  entretien      Entretien @relation(fields: [entretienId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  service        Produit?  @relation(fields: [idService], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceCatalog Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([entretienId, numLigne])
  @@index([idService])
  @@index([serviceId])
}

model CarWash {
  id             Int      @id @default(autoincrement())
  date           DateTime @unique @db.Date
  indexOuverture Decimal  @db.Decimal(15, 3)
  indexFermeture Decimal  @db.Decimal(15, 3)
  nombreLavage   Decimal  @db.Decimal(15, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SetParam {
  id                      Int      @id @default(1)
  stationId               Int?     @unique
  nomStation              String   @db.VarChar(160)
  adresse                 String?  @db.VarChar(255)
  tel                     String?  @db.VarChar(30)
  mf                      String?  @db.VarChar(40)
  rc                      String?  @db.VarChar(40)
  logoUrl                 String?  @db.Text
  timbre                  Decimal  @default(0) @db.Decimal(15, 3)
  tauxTVADefaut           Decimal  @default(19) @db.Decimal(15, 3)
  devise                  String   @default("TND") @db.VarChar(10)
  seuilEcartAutoApprove   Decimal  @default(0.500) @db.Decimal(15, 3)
  seuilEcartGerantApprove Decimal  @default(5.000) @db.Decimal(15, 3)
  seuilEcartBloque        Decimal  @default(20.000) @db.Decimal(15, 3)
  fondsCaisseDefaut       Decimal  @default(200.000) @db.Decimal(15, 3)
  seuilAlerteCuve         Decimal  @default(0.200) @db.Decimal(5, 3)
  seuilJaugeageAlerte     Decimal  @default(100.000) @db.Decimal(15, 3)
  station                 Station? @relation(fields: [stationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Compteur {
  id               Int      @id @default(1)
  lastNumBL        Int      @default(0)
  lastNumFact      Int      @default(0)
  lastNumAchatEss  Int      @default(0)
  lastNumAchatProd Int      @default(0)
  lastNumDepense   Int      @default(0)
  lastNumRecette   Int      @default(0)
  lastNumCredit    Int      @default(0)
  lastNumReg       Int      @default(0)
  lastNumRegFour   Int      @default(0)
  lastNumInvent    Int      @default(0)
  lastNumInvCar    Int      @default(0)
  lastNumTransfert Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model POSTicket {
  id          Int       @id @default(autoincrement())
  caisseId    Int
  equipeId    Int
  vendeurId   Int
  date        DateTime  @default(now())
  totalHT     Decimal   @db.Decimal(15, 3)
  totalTTC    Decimal   @db.Decimal(15, 3)
  remise      Decimal   @default(0) @db.Decimal(15, 3)
  statut      String    @default("VALIDE") @db.VarChar(20)
  caisse      Caisse    @relation(fields: [caisseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  equipe      Equipe    @relation(fields: [equipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vendeur     Vendeur   @relation(fields: [vendeurId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lignes      POSTicketLine[]
  paiements   POSTicketPayment[]
  retours     RetourProduit[]

  @@index([caisseId, date])
  @@index([equipeId, date])
}

model POSTicketLine {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  produitId     Int
  quantite      Decimal   @db.Decimal(15, 3)
  prixUnitaire  Decimal   @db.Decimal(15, 3)
  remise       Decimal   @default(0) @db.Decimal(15, 3)
  total         Decimal   @db.Decimal(15, 3)
  ticket        POSTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  produit       Produit   @relation(fields: [produitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  retours       RetourProduitLine[]

  @@index([ticketId])
  @@index([produitId])
}

model POSTicketPayment {
  id            Int         @id @default(autoincrement())
  ticketId      Int
  modePaymentId Int
  montant       Decimal     @db.Decimal(15, 3)
  ticket        POSTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  modePayment   ModePayment @relation(fields: [modePaymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId])
  @@index([modePaymentId])
}

model Promotion {
  id          Int       @id @default(autoincrement())
  libelle     String    @db.VarChar(160)
  dateDebut   DateTime  @db.Date
  dateFin     DateTime  @db.Date
  remise      Decimal   @default(0) @db.Decimal(15, 3)
  actif       Boolean   @default(true)
  produits    PromotionProduit[]

  @@index([dateDebut, dateFin, actif])
}

model PromotionProduit {
  promotionId Int
  produitId   Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  produit     Produit   @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([promotionId, produitId])
  @@index([produitId])
}

model RetourProduit {
  id        Int       @id @default(autoincrement())
  ticketId  Int
  date      DateTime  @default(now())
  totalTTC  Decimal   @db.Decimal(15, 3)
  statut    String    @default("VALIDE") @db.VarChar(20)
  ticket    POSTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lignes    RetourProduitLine[]

  @@index([ticketId, date])
}

model RetourProduitLine {
  id          Int           @id @default(autoincrement())
  retourId    Int
  ticketLineId Int
  quantite    Decimal       @db.Decimal(15, 3)
  montant     Decimal       @db.Decimal(15, 3)
  retour      RetourProduit @relation(fields: [retourId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ticketLine  POSTicketLine @relation(fields: [ticketLineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([retourId])
  @@index([ticketLineId])
}
